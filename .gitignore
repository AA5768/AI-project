# Python
backend/.venv/
__pycache__/
*.pyc

# SQLite (regenerated by ingestion pipeline, not committed).
# The .db.* glob matters: a backup named app.db.bak-20260921 does not match *.db,
# and a 2.7 MB binary is an easy thing to commit by accident.
*.db
*.db-journal
*.db.*

# Eval output (regenerated by `python -m eval.run_eval --json`)
eval-results.json
eval-*.json

# Node / frontend
frontend/node_modules/
frontend/dist/

# Env
.env
.env.local

# Editor / OS
.vscode/
.DS_Store

# Claude Code's per-machine permission allowlist: local paths, no value to
# anyone else. launch.json is kept -- it is the project's dev server config.
.claude/settings.local.json

